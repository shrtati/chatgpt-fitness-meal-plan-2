<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>12-Week Personal Health Dashboard</title>
<style>
  :root {
    --bg:#f6f4ef; --card:#fff; --text:#242424; --muted:#777;
    --line:#e7e3da; --accent:#6d7f68; --accent2:#c9d5c2;
    --danger:#a95d5d; --shadow:0 8px 30px rgba(0,0,0,.06);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.45}
  .wrap{max-width:1050px;margin:auto;padding:22px}
  header{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}
  h1,h2,h3{margin:0 0 8px} h1{font-size:30px} h2{font-size:21px} h3{font-size:16px}
  .muted{color:var(--muted);font-size:14px}
  .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:#e9eee6;font-size:12px;font-weight:700}
  .grid{display:grid;gap:14px}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .g3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:var(--shadow)}
  .hero{background:linear-gradient(135deg,#e9eee6,#fff);border:none}
  .stat{font-size:27px;font-weight:750}.small{font-size:12px;color:var(--muted)}
  .bar{height:10px;background:#eceae4;border-radius:99px;overflow:hidden;margin:10px 0}.fill{height:100%;background:var(--accent);width:0%;transition:.25s}
  button,input,select{font:inherit} button{border:0;border-radius:11px;padding:10px 13px;background:var(--accent);color:white;font-weight:650;cursor:pointer}
  button.secondary{background:#eceae4;color:#333} button.danger{background:#f1dddd;color:#7c3434}
  input,select{width:100%;padding:10px;border:1px solid var(--line);border-radius:10px;background:white}
  label{display:block;font-size:12px;font-weight:700;margin-bottom:5px}
  .row{display:flex;gap:10px;align-items:center}.between{justify-content:space-between}
  .timeline{position:relative}.item{display:grid;grid-template-columns:75px 1fr auto;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}
  .item:last-child{border-bottom:0}.time{font-weight:750;font-size:13px}.item.done .title{text-decoration:line-through;color:var(--muted)}
  .check{width:22px;height:22px;accent-color:var(--accent)}
  .food-row{display:grid;grid-template-columns:1.5fr .65fr .65fr auto;gap:8px;margin:8px 0}
  table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left}
  .tag{font-size:11px;padding:4px 7px;border-radius:7px;background:#f0eee8}
  .week{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.day{flex:1;min-width:75px;border:1px solid var(--line);border-radius:12px;padding:9px;text-align:center;font-size:12px}
  .day.active{border-color:var(--accent);background:#eef3eb}.day.complete{background:#e9eee6}
  .notice{padding:12px;border-radius:12px;background:#f4f0e8;font-size:13px}
  .warning{background:#f8eeee;color:#733b3b}.success{background:#edf4eb;color:#385337}
  .hidden{display:none}
  .footer{margin-top:20px;color:var(--muted);font-size:12px;text-align:center}
  @media(max-width:750px){.g2,.g3{grid-template-columns:1fr}.item{grid-template-columns:58px 1fr auto}.food-row{grid-template-columns:1fr 70px 75px auto}.wrap{padding:14px}h1{font-size:25px}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <span class="pill">12-WEEK PROGRAM</span>
      <h1>Personal Health Dashboard</h1>
      <div class="muted">Your daily plan, food log, fitness, and check-ins — all in one place.</div>
    </div>
    <button class="secondary" onclick="resetAll()">Reset data</button>
  </header>

  <section class="card hero">
    <div class="row between">
      <div><h2 id="dateTitle">Today</h2><div class="muted" id="weekLabel"></div></div>
      <div><span class="pill" id="dayType">NORMAL DAY</span></div>
    </div>
    <div class="week" id="weekStrip"></div>
  </section>

  <div class="grid g3" style="margin-top:14px">
    <div class="card"><div class="small">Weight</div><div class="stat" id="weightStat">—</div><div class="small">Goal: 56 kg</div></div>
    <div class="card"><div class="small">Today's calories</div><div class="stat"><span id="calStat">0</span><span class="small"> / <span id="calTarget">1500</span> kcal</span></div><div class="bar"><div class="fill" id="calFill"></div></div></div>
    <div class="card"><div class="small">Protein</div><div class="stat"><span id="proteinStat">0</span><span class="small"> / 90 g</span></div><div class="bar"><div class="fill" id="proteinFill"></div></div></div>
  </div>

  <section class="card" style="margin-top:14px">
    <div class="row between"><div><h2>Today's timeline</h2><div class="muted">Check items as you complete them.</div></div><span id="dailyPct" class="pill">0% complete</span></div>
    <div class="timeline" id="timeline"></div>
  </section>

  <div class="grid g2" style="margin-top:14px">
    <section class="card">
      <div class="row between"><div><h2>Food & calorie log</h2><div class="muted">Use estimated calories for restaurant food.</div></div><span class="tag">2 meals + coffee/matcha</span></div>
      <div id="foodRows"></div>
      <button class="secondary" onclick="addFoodRow()">+ Add food</button>
      <div class="notice" style="margin-top:12px">
        <b>Daily result:</b> <span id="foodMessage">Add your food below.</span>
      </div>
    </section>

    <section class="card">
      <h2>Quick health check</h2>
      <div class="grid g2">
        <div><label>Water (ml)</label><input id="water" type="number" min="0" step="50" placeholder="2000"></div>
        <div><label>Sleep (hours)</label><input id="sleep" type="number" min="0" max="24" step=".1" placeholder="7.5"></div>
        <div><label>Energy (1–5)</label><select id="energy"><option value="">—</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div>
        <div><label>Hunger (1–5)</label><select id="hunger"><option value="">—</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div>
      </div>
      <div style="margin-top:12px"><label>Back comfort / unusual symptoms</label>
        <select id="symptoms"><option>No unusual symptoms</option><option>Mild discomfort</option><option>Significant pain/discomfort</option><option>Neurological symptoms</option></select>
      </div>
      <div style="margin-top:12px"><label>Notes</label><input id="notes" placeholder="Anything worth remembering?"></div>
    </section>
  </div>

  <section class="card" style="margin-top:14px">
    <div class="row between"><div><h2>Fitness plan</h2><div class="muted">Only do exercises you have been medically cleared to perform.</div></div><span id="fitnessPct" class="pill">0% complete</span></div>
    <div id="fitnessPlan"></div>
    <div class="notice warning" style="margin-top:12px">
      Your scoliosis surgery and spinal hardware make individualized medical clearance important. Stop if you develop pain, neurological symptoms, or anything unusual, and follow your surgeon/physio's restrictions over this dashboard.
    </div>
  </section>

  <section class="card" style="margin-top:14px">
    <h2>Weekly progress</h2>
    <div class="grid g3">
      <div><div class="small">Exercise completion</div><div class="stat" id="weekExercise">0%</div></div>
      <div><div class="small">Nutrition logging</div><div class="stat" id="weekNutrition">0%</div></div>
      <div><div class="small">Tracker completion</div><div class="stat" id="weekTracker">0%</div></div>
    </div>
    <div class="notice success" style="margin-top:12px" id="weeklyMessage">Your first job is consistency, not perfection.</div>
  </section>

  <section class="card" style="margin-top:14px">
    <div class="row between"><div><h2>12-week journey</h2><div class="muted">Four-week phases with check-ins at Weeks 4, 8 and 12.</div></div></div>
    <div id="phases"></div>
  </section>

  <section class="card" style="margin-top:14px">
    <h2>Weight log</h2>
    <div class="grid g3">
      <div><label>Today's weight (kg)</label><input id="weightInput" type="number" step=".1" min="30" max="150" placeholder="68.0"></div>
      <div><label>Waist (cm, optional)</label><input id="waistInput" type="number" step=".1" min="40" max="200"></div>
      <div style="display:flex;align-items:end"><button onclick="saveMetrics()">Save today's measurements</button></div>
    </div>
    <div style="overflow:auto;margin-top:14px"><table><thead><tr><th>Date</th><th>Week</th><th>Weight</th><th>Waist</th></tr></thead><tbody id="weightTable"></tbody></table></div>
  </section>

  <div class="footer">Saved automatically in this browser using local storage. This dashboard is for tracking and planning, not medical diagnosis.</div>
</div>

<script>
const KEY="personalHealthDashboard_v1";
const defaults={
  startDate:new Date().toISOString().slice(0,10),
  targetCalories:1500, proteinTarget:90, waterTarget:2000,
  days:{}, weights:{}
};
let data=JSON.parse(localStorage.getItem(KEY)||"null")||defaults;
if(!data.days) data.days={}; if(!data.weights) data.weights={};

function iso(d){return d.toISOString().slice(0,10)}
function dayObj(date){ if(!data.days[date]) data.days[date]={checks:{},foods:[],fitness:{},water:"",sleep:"",energy:"",hunger:"",symptoms:"No unusual symptoms",notes:""}; return data.days[date];}
function dateFromInput(){return new Date(document.getElementById("dateTitle").dataset.date+"T12:00:00")}
let current=iso(new Date());

const schedule={
  Monday:{type:"FASTING DAY",items:[["04:30","End of pre-fast hydration / prepare for fasting","routine"],["18:00","Iftar — balanced meal","meal"],["19:30","Easy recovery / walk if cleared","exercise"],["21:30","Daily check-in + tracker","check"]]},
  Tuesday:{type:"SWIMMING DAY",items:[["11:30","Home-cooked lunch","meal"],["17:30","Swimming — planned gentle session","exercise"],["18:30","Dinner — purchased balanced meal","meal"],["21:30","Daily check-in + tracker","check"]]},
  Wednesday:{type:"STABILITY DAY",items:[["11:30","Home-cooked lunch","meal"],["17:30","Approved strength / stability session","exercise"],["18:30","Dinner — purchased balanced meal","meal"],["21:30","Daily check-in + tracker","check"]]},
  Thursday:{type:"FASTING DAY",items:[["04:30","End of pre-fast hydration / prepare for fasting","routine"],["18:00","Iftar — balanced meal","meal"],["19:30","Easy recovery / walk if cleared","exercise"],["21:30","Daily check-in + tracker","check"]]},
  Friday:{type:"MOBILITY DAY",items:[["11:30","Home-cooked lunch","meal"],["17:30","Approved mobility / posture session","exercise"],["18:30","Dinner — purchased balanced meal","meal"],["21:30","Daily check-in + tracker","check"]]},
  Saturday:{type:"SWIMMING DAY",items:[["11:30","Home-cooked lunch","meal"],["16:30","Swimming — planned gentle session","exercise"],["18:30","Dinner — purchased balanced meal","meal"],["21:30","Daily check-in + tracker","check"]]},
  Sunday:{type:"REST + REVIEW",items:[["11:30","Home-cooked lunch","meal"],["18:30","Dinner — flexible balanced meal","meal"],["20:30","Weekly review","review"],["21:30","Complete tracker","check"]}
};

const fitness={
  Monday:["Recovery / easy walking if cleared","15–30 min, comfortable pace"],
  Tuesday:["Swimming","Start around 20–30 min; progress only if cleared and well tolerated"],
  Wednesday:["Approved stability / resistance","Short session; use only clinician-approved movements"],
  Thursday:["Recovery / easy walking if cleared","15–30 min, comfortable pace"],
  Friday:["Approved mobility / posture","10–20 min; no forced stretching or spinal movements"],
  Saturday:["Swimming","Start around 20–30 min; progress only if cleared and well tolerated"],
  Sunday:["Rest","No workout required"]
};

function getWeek(date=current){
  const start=new Date(data.startDate+"T12:00:00"), d=new Date(date+"T12:00:00");
  return Math.max(1,Math.min(12,Math.floor((d-start)/86400000/7)+1));
}
function save(){localStorage.setItem(KEY,JSON.stringify(data))}
function render(){
  const d=new Date(current+"T12:00:00"), day=d.toLocaleDateString("en-US",{weekday:"long"});
  const obj=dayObj(current); document.getElementById("dateTitle").textContent=d.toLocaleDateString("en-US",{weekday:"long",month:"long",day:"numeric"});
  document.getElementById("dateTitle").dataset.date=current;
  document.getElementById("weekLabel").textContent=`Week ${getWeek()} of 12`;
  document.getElementById("dayType").textContent=schedule[day].type;
  renderWeek(d); renderTimeline(obj,day); renderFoods(obj); renderHealth(obj); renderFitness(obj,day); renderMetrics(); renderPhases(); updateStats(obj,day);
}
function renderWeek(d){
  const monday=new Date(d); monday.setDate(d.getDate()-((d.getDay()+6)%7));
  let h=""; for(let i=0;i<7;i++){let x=new Date(monday);x.setDate(monday.getDate()+i);let k=iso(x),o=dayObj(k),count=Object.values(o.checks||{}).filter(Boolean).length; h+=`<div class="day ${k===current?"active":""} ${count>=schedule[x.toLocaleDateString("en-US",{weekday:"long"})].items.length?"complete":""}" onclick="setDate('${k}')"><b>${x.toLocaleDateString("en-US",{weekday:"short"})}</b><br>${x.getDate()}<br><span>${count} ✓</span></div>`} document.getElementById("weekStrip").innerHTML=h;
}
function setDate(k){current=k;render()}
function renderTimeline(o,day){
 let h=""; schedule[day].items.forEach((it,i)=>{let id="t"+i,done=!!o.checks[id];h+=`<div class="item ${done?"done":""}"><div class="time">${it[0]}</div><div><div class="title"><b>${it[1]}</b></div><div class="small">${it[2]}</div></div><input class="check" type="checkbox" ${done?"checked":""} onchange="toggleCheck('${id}',this.checked)"></div>`}); document.getElementById("timeline").innerHTML=h;
}
function toggleCheck(id,v){dayObj(current).checks[id]=v;save();render()}
function renderFoods(o){
 let h=o.foods.map((f,i)=>`<div class="food-row"><input value="${esc(f.name)}" placeholder="Food / drink" onchange="foodEdit(${i},'name',this.value)"><input type="number" min="0" value="${f.cal||""}" placeholder="kcal" onchange="foodEdit(${i},'cal',this.value)"><input type="number" min="0" value="${f.protein||""}" placeholder="protein g" onchange="foodEdit(${i},'protein',this.value)"><button class="danger" onclick="removeFood(${i})">×</button></div>`).join("");
 document.getElementById("foodRows").innerHTML=h||`<div class="notice">Add your meals, snacks, coffee or matcha. Calories and protein are estimates unless you know the exact nutrition information.</div>`;
}
function esc(s){return String(s||"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll('"',"&quot;")}
function addFoodRow(){dayObj(current).foods.push({name:"",cal:0,protein:0});save();render()}
function foodEdit(i,k,v){dayObj(current).foods[i][k]=k==="name"?v:Number(v)||0;save();updateStats(dayObj(current));}
function removeFood(i){dayObj(current).foods.splice(i,1);save();render()}
function renderHealth(o){
 ["water","sleep","energy","hunger","symptoms","notes"].forEach(id=>{let e=document.getElementById(id); if(e){e.value=o[id]??"";e.onchange=()=>{o[id]=e.value;save();updateStats(o)}}});
}
function renderFitness(o,day){
 const plan=fitness[day]; const id="fitness"; const done=!!o.fitness[id];
 document.getElementById("fitnessPlan").innerHTML=`<div class="item ${done?"done":""}" style="border-bottom:0"><div class="time">TODAY</div><div><div class="title"><b>${plan[0]}</b></div><div class="small">${plan[1]}</div></div><input class="check" type="checkbox" ${done?"checked":""} onchange="toggleFitness(this.checked)"></div>`;
}
function toggleFitness(v){dayObj(current).fitness.fitness=v;save();render()}
function updateStats(o,day){
 const cal=o.foods.reduce((a,f)=>a+(Number(f.cal)||0),0), pro=o.foods.reduce((a,f)=>a+(Number(f.protein)||0),0);
 document.getElementById("calStat").textContent=Math.round(cal);document.getElementById("proteinStat").textContent=Math.round(pro);
 document.getElementById("calTarget").textContent=data.targetCalories;document.getElementById("calFill").style.width=Math.min(100,cal/data.targetCalories*100)+"%";document.getElementById("proteinFill").style.width=Math.min(100,pro/data.proteinTarget*100)+"%";
 document.getElementById("foodMessage").textContent=cal===0?"Add your food below.":cal<=data.targetCalories?`${Math.round(data.targetCalories-cal)} kcal remaining.`:`${Math.round(cal-data.targetCalories)} kcal above today's target. One higher day is not a failure; look at your weekly trend.`;
 const total=schedule[day].items.length, checked=Object.values(o.checks).filter(Boolean).length+(o.fitness.fitness?1:0), denom=total+1;
 const pct=Math.round(checked/denom*100);document.getElementById("dailyPct").textContent=pct+"% complete";document.getElementById("fitnessPct").textContent=(o.fitness.fitness?"100%":"0%")+" complete";
 const w=getWeek();let dates=[];const start=new Date(data.startDate+"T12:00:00");start.setDate(start.getDate()+(w-1)*7);for(let i=0;i<7;i++){let x=new Date(start);x.setDate(start.getDate()+i);dates.push(iso(x))}
 let ex=0,nut=0,tr=0;dates.forEach(k=>{let x=dayObj(k);if(x.fitness.fitness)ex++;if(x.foods.some(f=>(Number(f.cal)||0)>0))nut++;let dn=Object.values(x.checks||{}).filter(Boolean).length;if(dn>=schedule[new Date(k+"T12:00:00").toLocaleDateString("en-US",{weekday:"long"})].items.length)tr++});
 document.getElementById("weekExercise").textContent=Math.round(ex/7*100)+"%";document.getElementById("weekNutrition").textContent=Math.round(nut/7*100)+"%";document.getElementById("weekTracker").textContent=Math.round(tr/7*100)+"%";
 document.getElementById("weeklyMessage").textContent=tr>=5?"Strong consistency this week. Keep the plan steady.":"Focus on completing today's plan; you do not need to make up missed days.";
}
function saveMetrics(){
 const w=document.getElementById("weightInput").value,wa=document.getElementById("waistInput").value;if(w)data.weights[current]={weight:Number(w),waist:wa?Number(wa):""};save();render();
}
function renderMetrics(){
 const entries=Object.entries(data.weights).sort((a,b)=>b[0].localeCompare(a[0]));document.getElementById("weightTable").innerHTML=entries.map(([k,v])=>`<tr><td>${k}</td><td>Week ${getWeek(k)}</td><td>${v.weight} kg</td><td>${v.waist||"—"}</td></tr>`).join("")||`<tr><td colspan="4">No measurements logged yet.</td></tr>`;
 const latest=entries[0]?.[1]?.weight;document.getElementById("weightStat").textContent=latest?latest+" kg":"—";
 if(data.weights[current]){document.getElementById("weightInput").value=data.weights[current].weight;document.getElementById("waistInput").value=data.weights[current].waist||""}
}
function renderPhases(){
 const phases=[["Weeks 1–4","Foundation","Build consistency, learn your hunger/energy patterns, establish movement habits.","Week 4 Check-In"],["Weeks 5–8","Build","Progress duration or resistance only when your body and clinician-approved plan allow it.","Week 8 Check-In"],["Weeks 9–12","Consolidate","Practice a routine you can maintain after the program ends.","Week 12 Final Review"]];
 document.getElementById("phases").innerHTML=phases.map((p,i)=>`<div class="card" style="box-shadow:none;margin-top:10px;background:#faf9f6"><div class="row between"><div><span class="pill">${p[0]}</span><h3 style="margin-top:8px">${p[1]}</h3><div class="muted">${p[2]}</div></div><button class="secondary" onclick="phaseAlert(${i})">${p[3]}</button></div></div>`).join("");
}
function phaseAlert(i){
 const checks=["Weight trend, waist, exercise consistency, hunger, energy, sleep, recovery and back comfort.","Compare with Week 4 and decide: continue, cautiously progress, adjust, or prioritize recovery.","Compare Week 1 → Week 12 and decide what is sustainable for the next 12 weeks."];
 alert(checks[i]);
}
function resetAll(){if(confirm("Delete all dashboard data?")){localStorage.removeItem(KEY);location.reload()}}
render();
</script>
</body>
</html>